# Copy to backend/.env for local dev, or set these as Railway service variables.
# Required — the app refuses to boot without it. Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# Environment
APP_ENV=production
APP_DEBUG=false

# Database.
# Default (no DATABASE_URL) = bundled SQLite file, which does NOT persist on
# Railway's ephemeral disk. Two options:
#   1) Attach a Railway Volume mounted at /data and point SQLite at it:
#        DATABASE_URL=sqlite+aiosqlite:////data/casper.db
#        DATABASE_URL_SYNC=sqlite:////data/casper.db
#   2) Use Railway Postgres (add the plugin) with the async driver:
#        DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME
# DATABASE_URL=

# CORS — only needed if the frontend is served from a DIFFERENT origin.
# In the single-service Docker deploy the SPA is same-origin, so this can stay
# as the local dev default.
ALLOWED_ORIGINS=http://localhost:5173

# First-run seed. Set a unique strong password; production rejects an empty value.
SEED_ADMIN_EMAIL=admin@casper.com
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=Shringar House

# Store originals on a mounted volume in production.
# UPLOADS_DIR=/data/uploads/pnl
# Product images also require persistent storage. Mount the same volume across
# deployments and set PRODUCT_MEDIA_DIR to a directory on it.
# PRODUCT_MEDIA_DIR=/data/uploads/products
