# Frontend build-time config. Copy to .env.production (or set in the
# Cloudflare Pages dashboard → Settings → Environment variables) before build.
#
# Absolute URL of the deployed backend API, including the /api/v1 prefix.
# Leave unset for local dev — the Vite proxy handles /api/v1 automatically.
VITE_API_BASE=https://your-backend-host.example.com/api/v1
