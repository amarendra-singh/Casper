# Backend configuration. Copy to backend/.env (git-ignored) and fill in.

# REQUIRED — the app aborts on boot without it. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-secret

# JWT tuning (optional — these are the defaults)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — omit for local SQLite (bundled casper.db). In production set an
# async Postgres URL (Neon / Supabase / Vercel Postgres). See DEPLOYMENT.md.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# CORS — comma-separated origins allowed to call the API. Add your deployed
# frontend origin here in production (e.g. the Cloudflare Pages URL).
ALLOWED_ORIGINS=http://localhost:5173

# App
APP_NAME=CasperV2
APP_ENV=development
APP_DEBUG=true          # set false in production — also hides /docs
APP_HOST=0.0.0.0
APP_PORT=8000

# Pricing default
DEFAULT_DAMAGE_PERCENT=15.0
